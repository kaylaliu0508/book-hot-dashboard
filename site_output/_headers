# Cloudflare Pages 自定义响应头
# 文档: https://developers.cloudflare.com/pages/configuration/headers/
#
# 规则：上面规则优先匹配，命中后不再匹配下面。
# 目的：让数据 JS push 后 5 分钟内全网自动生效，无需手动 purge / 加版本号。

# ============================================================
# 1. 频繁更新的数据 JS（含历史版本副本）—— 5 分钟 CDN 缓存
# ============================================================

# 通配匹配 select 目录下所有数据/逻辑 JS（包括 rank-data*.js / select-data*.js / select-app.js / recommend-data.js / bench-data.js / isbn-image-map.js / 任意 -v20260602 等版本副本）
/select/rank-data*.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/select-data*.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/select-app*.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/recommend-data*.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/bench-data*.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/isbn-image-map*.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

# ============================================================
# 2. 主入口 HTML（每次访问都重新校验最新版）
# ============================================================

/
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/select/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/select/
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/summer/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/summer/
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/ai/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/ai/
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/stats/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

# ============================================================
# 3. 其他大体量 JS / CSS —— 1 小时 CDN 缓存
# 注意：不要写 /select/*.js 这种通配，会跟上面的精确规则叠加导致响应头出现两次 Cache-Control
# 真正需要 1 小时缓存的逐项明列即可
# ============================================================

/assets/*.js
  Cache-Control: public, max-age=300, s-maxage=3600

/*.css
  Cache-Control: public, max-age=300, s-maxage=3600

# ============================================================
# 4. 静态资源（图片/字体）—— 保留默认 CF 7 天 CDN 缓存（无需配置）
# ============================================================

