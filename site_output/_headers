# Cloudflare Pages 自定义响应头
# 文档: https://developers.cloudflare.com/pages/configuration/headers/
#
# 优先级：上面规则覆盖下面，从上到下匹配。
# 一旦命中匹配规则即应用所有 header（不会继续匹配下面）。

# ============================================================
# 1. 频繁更新的数据 JS / JSON —— 5 分钟 CDN 缓存（push 后 5 分钟内全网生效）
# ============================================================

/select/rank-data.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/select-data.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/select-app.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/recommend-data.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/bench-data.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

/select/isbn-image-map.js
  Cache-Control: public, max-age=60, s-maxage=300, must-revalidate

# 主入口 HTML —— 不缓存（每次都从 CF Pages 拉最新）
/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/select/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

# ============================================================
# 2. 大体量但偶尔变动的 JS / CSS —— 1 小时 CDN 缓存
# ============================================================

/select/*.js
  Cache-Control: public, max-age=300, s-maxage=3600

/assets/*.js
  Cache-Control: public, max-age=300, s-maxage=3600

/*.css
  Cache-Control: public, max-age=300, s-maxage=3600

# ============================================================
# 3. 其他静态资源（图片/字体）—— 保留默认 7 天 CDN 缓存
# ============================================================
# CF Pages 默认对静态资源设置 s-maxage=604800（7 天），无需额外配置
